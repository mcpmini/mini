#!/usr/bin/env bash
# Git pre-push hook: refuses a push whose commits fail CI's lint job (golangci-lint and scripts/lint.sh).
set -uo pipefail

export PATH="/opt/homebrew/bin:$(go env GOPATH)/bin:$PATH"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  dir=$(mktemp -d)
  log="$dir.log"
  # Lint the pushed commit, not the working tree: check.sh's local formatting can leave the fix uncommitted,
  # and git-spice pushes branches that aren't checked out.
  git worktree add -q --detach "$dir" "$local_sha"
  if ! (cd "$dir" && golangci-lint run ./... && scripts/lint.sh) >"$log" 2>&1; then
    echo "pre-push: lint fails on ${local_ref#refs/heads/} at ${local_sha:0:8}:"
    tail -20 "$log"
    status=1
  fi
  git worktree remove --force "$dir"
  rm -f "$log"
done

if [[ "$status" -ne 0 ]]; then
  echo "Push refused. Commit the fixes (./check.sh applies the formatting ones), or push with --no-verify."
fi
exit "$status"
