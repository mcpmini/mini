#!/usr/bin/env bash
# Git pre-push hook: refuses a push whose commits fail CI's lint.
# Install: ln -s "$PWD/scripts/pre-push" "$(git rev-parse --git-common-dir)/hooks/pre-push"
#
# Run locally, check.sh formats the working tree before it lints, so a reformat left unstaged passes there and
# fails in CI. gs also pushes branches that aren't checked out. So each pushed commit is linted in its own worktree.
set -uo pipefail

export PATH="/opt/homebrew/bin:$(go env GOPATH)/bin:$PATH"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  dir=$(mktemp -d)
  log="$dir.log"
  git worktree add -q --detach "$dir" "$local_sha"
  if ! (cd "$dir" && golangci-lint run ./... &&
    GOFLAGS="-tags=integration,test" go run ./tools/structlint ./...) >"$log" 2>&1; then
    echo "pre-push: lint fails on ${local_ref#refs/heads/} at ${local_sha:0:8}:"
    tail -20 "$log"
    status=1
  fi
  git worktree remove --force "$dir"
  rm -f "$log"
done

if [[ "$status" -ne 0 ]]; then
  echo "Push refused. Commit the fixes (./check.sh applies the formatting ones), or push with --no-verify."
fi
exit "$status"
